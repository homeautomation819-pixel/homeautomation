# Supabase credentials for the client-side quote form.
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL editor,
# then copy Project URL and anon public key from Project Settings > API.
# These are inlined at build time (NEXT_PUBLIC_*). Rebuild after changing them.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
